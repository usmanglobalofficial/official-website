{
  "name": "CustomerInquiry",
  "properties": {
    "company": {
      "type": "string"
    },
    "crm_contact_id": {
      "type": "string"
    },
    "crm_customer_code": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "source": {
      "default": "website",
      "type": "string"
    },
    "status": {
      "default": "new",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "closed"
      ],
      "type": "string"
    }
  },
  "required": [
    "name",
    "email",
    "phone",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}